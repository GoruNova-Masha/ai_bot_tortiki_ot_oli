# =============================================================================
# Шаблон переменных окружения — «Тортики от Оли»
# Скопируйте в .env и заполните значения. Файл .env НЕ коммитить в git.
# =============================================================================

# --- Telegram (обязательно) ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# ID чата менеджера для передачи лида (личка или группа).
# Узнать ID: напишите боту @userinfobot или @getidsbot
TELEGRAM_MANAGER_CHAT_ID=

# ID администраторов для /admin, /adddate (через запятую). По умолчанию = менеджер
ADMIN_USER_IDS=

# --- ИИ для ответов (обязательно один провайдер) ---
# OpenAI-совместимый API (OpenAI, OpenRouter, локальный прокси и т.д.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Альтернатива: Anthropic (раскомментируйте, если не используете OpenAI)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- Безопасность ---
# true = бот отвечает только пользователям из ALLOWED_USER_IDS (для теста)
BOT_WHITELIST_ENABLED=false
# Список Telegram user_id через запятую (пусто = без ограничения при false)
ALLOWED_USER_IDS=

# Лимит сообщений от одного пользователя в минуту (защита от спама)
RATE_LIMIT_PER_MINUTE=15

# Максимум символов в одном сообщении пользователя
MAX_MESSAGE_LENGTH=2000

# Секрет для webhook (если будете использовать webhook вместо polling)
# Сгенерируйте: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=

# Режим: polling | webhook
BOT_MODE=polling

# Порт webhook (только для BOT_MODE=webhook)
WEBHOOK_PORT=8443
WEBHOOK_PATH=/webhook

# --- Бизнес ---
# Телефон кондитера для перевода клиента после заявки
BUSINESS_PHONE=+79308001479

# Путь к файлу брифа для системного промпта
BRIEF_FILE_PATH=brif.md

# Часовой пояс для напоминаний о датах
TZ=Europe/Moscow

# Уровень логов: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
